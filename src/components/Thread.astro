---
// The gold thread: starts at the hero pen nib, runs the page's rail,
// passes through every section node and ends in the footer logo's rule.
---
<svg class="thread" data-thread aria-hidden="true" focusable="false">
  <g class="thread__track"></g>
  <g class="thread__ink"></g>
  <rect class="thread__tip" width="9" height="9" x="-4.5" y="-4.5" transform="rotate(45)" />
</svg>
<style>
  .thread {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .thread :global(path) { fill: none; vector-effect: non-scaling-stroke; }
  .thread__track :global(path) { stroke: var(--gold); stroke-width: 1; opacity: 0.16; }
  .thread__ink :global(path) { stroke: var(--gold); stroke-width: 1.25; stroke-linecap: round; }
  .thread__tip { fill: var(--gold); opacity: 0; }
</style>
