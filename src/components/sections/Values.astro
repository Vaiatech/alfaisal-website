---
import Eyebrow from '../Eyebrow.astro';
import { values } from '../../data/site';
const total = String(values.items.length).padStart(2, '0');
---
<section class="section values" id="values" aria-labelledby="values-title">
  <div class="wrap railed">
    <Eyebrow index="05" label={values.label} />
    <h2 id="values-title" class="display h2 values__title" data-reveal="lines">{values.title}</h2>

    <div class="values__grid" data-values>
      <ol class="values__list">
        {values.items.map((v, i) => (
          <li class="value" data-value={i} data-reveal="fade">
            <button
              class="value__btn"
              type="button"
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-controls="values-panel"
            >
              <span class="value__idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="display value__name">{v.title}</span>
              <span class="value__timer" aria-hidden="true"></span>
            </button>
            <p class="value__desc">{v.body}</p>
          </li>
        ))}
      </ol>

      <div class="values__panel" id="values-panel" aria-live="polite" data-reveal="fade">
        <p class="values__count" aria-hidden="true">
          <span data-values-index>01</span><span class="values__sep"></span><span>{total}</span>
        </p>
        <p class="display values__desc" data-values-desc>{values.items[0].body}</p>
        <p class="values__name" data-values-name>{values.items[0].title}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .values__title { max-width: 16ch; }
  .values__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(40px, 7vw, 120px);
    margin-top: clamp(56px, 7vw, 104px);
    align-items: center;
  }

  .values__list { border-top: 1px solid var(--line); }
  .value { border-bottom: 1px solid var(--line); }
  .value__btn {
    position: relative;
    width: 100%;
    display: flex;
    align-items: baseline;
    gap: 22px;
    padding-block: clamp(14px, 1.6vw, 22px);
    text-align: right;
  }
  .value__idx { font-size: 0.75rem; color: var(--gold-ink); direction: ltr; min-width: 2ch; font-variant-numeric: tabular-nums; }
  .value__name {
    font-size: clamp(1.9rem, 1.2rem + 2.3vw, 3.3rem);
    line-height: 1.3;
    color: var(--ink-3);
    transition: color 0.5s var(--ease-out), transform 0.7s var(--ease-out);
  }
  .value__btn:hover .value__name { color: var(--ink-2); }
  .value__btn[aria-pressed='true'] .value__name { color: var(--ink); transform: translateX(-10px); }
  .value__timer {
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: right;
  }
  .value__desc { display: none; }

  .values__panel { position: relative; padding-block: 24px; }
  .values__count {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.8rem;
    color: var(--ink-2);
    direction: ltr;
    justify-content: flex-end;
    font-variant-numeric: tabular-nums;
  }
  .values__count span:first-child { color: var(--gold-ink); }
  .values__sep { width: 32px; height: 1px; background: var(--line-2); }
  .values__desc {
    margin-top: clamp(20px, 3vw, 40px);
    font-size: var(--step-3);
    line-height: 1.5;
    min-height: 3em;
    text-wrap: balance;
  }
  .values__name { margin-top: 20px; color: var(--gold-ink); font-weight: 500; }

  /* without JS, or on small screens, show every description inline */
  :global(html:not(.js)) .value__desc { display: block; }
  :global(html:not(.js)) .values__panel { display: none; }
  :global(html:not(.js)) .value__name { color: var(--ink); }

  @media (max-width: 900px) {
    .values__grid { grid-template-columns: 1fr; }
    .values__panel { display: none; }
    .value__btn { pointer-events: none; padding-bottom: 4px; }
    .value__name { color: var(--ink) !important; transform: none !important; font-size: 2rem; }
    .value__desc { display: block; padding: 0 calc(2ch + 22px) 18px 0; color: var(--ink-2); }
    .value__timer { display: none; }
  }
</style>
