---
import Eyebrow from '../Eyebrow.astro';
import Lattice from '../Lattice.astro';
import { expertise } from '../../data/site';
---
<section class="section expertise" id="expertise" aria-labelledby="expertise-title">
  <div class="wrap railed">
    <Eyebrow index="02" label={expertise.label} />
    <div class="expertise__head">
      <h2 id="expertise-title" class="display h2" data-reveal="lines">{expertise.title}</h2>
      <p class="expertise__hint" data-reveal="fade" aria-hidden="true">
        <span class="node node--sm"></span>مرّر على أي مجال لاستعراضه
      </p>
    </div>

    <div class="panels" data-panels data-reveal="fade">
      {expertise.items.map((item, i) => (
        <article
          class:list={['panel', i === 0 && 'is-open']}
          data-panel
          tabindex="0"
          aria-labelledby={`area-${i}`}
        >
          <Lattice trigger="manual" cell={46} reach={0.9} strength={0.9} origin="0.5,0.92" class="panel__lattice" />
          <span class="panel__edge" aria-hidden="true"></span>
          <span class="panel__idx num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="panel__text">
            <h3 class="display panel__title" id={`area-${i}`}>{item.title}</h3>
            <div class="panel__reveal">
              <p class="panel__body">{item.body}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .expertise__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    flex-wrap: wrap;
  }
  .expertise__head :global(.h2) { max-width: 16ch; }
  .expertise__hint {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--step--1);
    color: var(--ink-2);
    padding-bottom: 0.9em;
  }

  /* Six panels; the one under the pointer opens, the rest make room. */
  .panels {
    display: flex;
    height: clamp(460px, 40vw, 600px);
    margin-top: clamp(48px, 6vw, 88px);
    border-block: 1px solid var(--line-2);
  }
  .panel {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(22px, 2vw, 32px) clamp(16px, 1.6vw, 26px);
    border-inline-start: 1px solid var(--line);
    outline-offset: -4px;
    cursor: default;
    transition: flex-grow 0.95s var(--ease-out), background-color 0.6s var(--ease-out);
  }
  .panel:first-child { border-inline-start: 0; }
  .panel.is-open { flex-grow: 3.4; }
  .panel > :not(:global(.lattice)) { position: relative; z-index: 1; }

  .panel__edge {
    position: absolute !important;
    inset: -1px 0 auto;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.9s var(--ease-out);
  }
  .panel.is-open .panel__edge { transform: scaleX(1); }

  .panel__idx {
    font-size: clamp(3.4rem, 2rem + 4vw, 6.5rem);
    line-height: 1;
    font-weight: 400;
    color: var(--gold);
    opacity: 0.3;
    align-self: flex-start;
    transition: opacity 0.7s var(--ease-out), transform 0.9s var(--ease-out);
    transform-origin: right top;
  }
  .panel.is-open .panel__idx { opacity: 1; }

  .panel__title {
    font-size: clamp(1.3rem, 0.85rem + 1.15vw, 2.15rem);
    line-height: 1.35;
    color: var(--ink-2);
    text-wrap: balance;
    transition: color 0.6s var(--ease-out);
  }
  .panel.is-open .panel__title,
  .panel:hover .panel__title { color: var(--ink); }

  /* the description keeps a fixed measure so it never reflows while the panel grows */
  .panel__reveal {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.9s var(--ease-out);
  }
  .panel.is-open .panel__reveal { grid-template-rows: 1fr; }
  .panel__body {
    overflow: hidden;
    width: clamp(15rem, 23vw, 24rem);
    margin-top: 0;
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.85;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.5s var(--ease-out), transform 0.8s var(--ease-out), margin-top 0.8s var(--ease-out);
  }
  .panel.is-open .panel__body {
    margin-top: 16px;
    opacity: 1;
    transform: none;
    transition-delay: 0.22s;
  }

  @media (max-width: 1024px) {
    .expertise__hint { display: none; }
    .panels { flex-direction: column; height: auto; }
    .panel {
      flex: none;
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: baseline;
      gap: 18px;
      border-inline-start: 0;
      border-top: 1px solid var(--line);
      padding-inline: 0;
    }
    .panel:first-child { border-top: 0; }
    .panel__idx { font-size: 2.4rem; opacity: 1; min-width: 2ch; }
    .panel__title { color: var(--ink); font-size: 1.7rem; }
    .panel__reveal { grid-template-rows: 1fr; }
    .panel__body { width: auto; opacity: 1; transform: none; margin-top: 8px; font-size: var(--step-0); }
    .panel__edge, .panel :global(.lattice) { display: none; }
  }
</style>
