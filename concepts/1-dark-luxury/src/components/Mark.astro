---
/**
 * The Al-Faisal logo, rebuilt from the traced vector so its parts can move.
 * - `parts` picks which groups to draw (mark = calligraphy+pen+scale+penband).
 * - `write` adds a stroke mask made of the 39 traced pen strokes so the
 *   calligraphy can write itself (driven from JS; without JS it shows fully).
 */
import logoRaw from '../../../shared/logo/alfaisal-logo-on-dark.svg?raw';
import strokes from '../../../shared/calligraphy-strokes.json';

interface Props {
  uid: string;
  variant: 'mark' | 'lockup' | 'header';
  write?: boolean;
  glow?: boolean;
  class?: string;
  label?: string;
}
const { uid, variant, write = false, glow = false, class: cls = '', label } = Astro.props;

const group = (id: string) => {
  const m = logoRaw.match(new RegExp(`<g id="${id}"[^>]*>([\\s\\S]*?)</g>`));
  return m ? m[1] : '';
};
const call = group('calligraphy');
const pen = group('pen');
const scale = group('scale');
const band = group('penband');
const wordmark = group('wordmark');
const tagline = group('tagline');
const rule = group('rule');

const viewBox =
  variant === 'lockup' ? '-10 -20 1051 1235' : variant === 'header' ? '110 -6 812 830' : '96 -30 840 880';
const m = write ? `url(#${uid}-write)` : undefined;
---
<svg
  class={`mark mark--${variant} ${cls}`}
  viewBox={viewBox}
  data-uid={uid}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <defs>
    <linearGradient id={`${uid}-gold`} gradientUnits="userSpaceOnUse" x1="120" y1="0" x2="900" y2="820">
      <stop offset="0" stop-color="#8f6a28" />
      <stop class="g-s1" offset="0.32" stop-color="#c9a25a" />
      <stop class="g-hi" offset="0.5" stop-color="#f7e2ac" />
      <stop class="g-s2" offset="0.68" stop-color="#d2ab62" />
      <stop offset="1" stop-color="#9c7431" />
    </linearGradient>
    <linearGradient id={`${uid}-pen`} gradientUnits="userSpaceOnUse" x1="540" y1="0" x2="780" y2="780">
      <stop offset="0" stop-color="#fbf4e6" />
      <stop offset="0.6" stop-color="#efe4cf" />
      <stop offset="1" stop-color="#cdbb98" />
    </linearGradient>
    {variant !== 'header' && (
      <radialGradient id={`${uid}-spark`}>
        <stop offset="0" stop-color="#fffaf0" />
        <stop offset="0.18" stop-color="#ffe7ad" />
        <stop offset="0.45" stop-color="#e2be76" stop-opacity="0.55" />
        <stop offset="1" stop-color="#c9a25a" stop-opacity="0" />
      </radialGradient>
    )}
    {glow && (
      <filter id={`${uid}-blur`} x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="22" />
      </filter>
    )}
    {write && (
      <mask id={`${uid}-write`} maskUnits="userSpaceOnUse" x="0" y="-40" width="1031" height="900">
        <g class="write" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round">
          {strokes.map((s: { d: string; w: number; l: number }) => (
            <path d={s.d} stroke-width={(s.w * 1.12).toFixed(1)} pathLength="1" data-l={s.l} />
          ))}
        </g>
      </mask>
    )}
    {write && (
      <clipPath id={`${uid}-penclip`}>
        <rect class="penclip" x="480" y="-20" width="340" height="820" />
      </clipPath>
    )}
  </defs>

  {glow && (
    <g class="m-glow" filter={`url(#${uid}-blur)`} aria-hidden="true">
      <g mask={m}><g fill="#e8c27a" set:html={call} /></g>
    </g>
  )}
  <g class="m-call" mask={m}><g fill={`url(#${uid}-gold)`} set:html={call} /></g>
  <g class="m-pen" clip-path={write ? `url(#${uid}-penclip)` : undefined}>
    <g fill={`url(#${uid}-pen)`} set:html={pen} />
    <g class="m-band" fill={`url(#${uid}-gold)`} set:html={band} />
  </g>
  <g class="m-scale"><g fill={`url(#${uid}-gold)`} set:html={scale} /></g>
  {variant === 'lockup' && (
    <g class="m-words">
      <g class="m-wordmark" fill="#f1eadf" set:html={wordmark} />
      <g class="m-rule" fill={`url(#${uid}-gold)`} set:html={rule} />
      <g class="m-tagline" fill="#e9dfcc" set:html={tagline} />
    </g>
  )}
  {variant !== 'header' && <circle class="m-spark" cx="834" cy="19" r="34" fill={`url(#${uid}-spark)`} opacity="0" />}
</svg>
