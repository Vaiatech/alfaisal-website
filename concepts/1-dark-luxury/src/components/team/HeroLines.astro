---
/**
 * The opening of page 3 · «سطور كثيرة… سطر واحد» — many lines, one line.
 * The firm's specialisms (the practice areas and the groups' scopes) drift across the page
 * in engraved gold, row against row; scrolling, they gather onto one gold line.
 */
import HeroCopy from './HeroCopy.astro';
import { getContent, type Lang } from '../../../../shared/i18n.ts';

interface Props { lang?: Lang }
const { lang = 'ar' } = Astro.props;
const { team, ui } = getContent(lang);
const terms = ui.terms;
// seven rows, each starting at a different place in the list so no two rows read alike
const rows = Array.from({ length: 7 }, (_, r) => {
  const start = (r * 7) % terms.length;
  return [...terms.slice(start), ...terms.slice(0, start)];
});
---
<!-- ============ 1 · OPENING — many lines, one line ============ -->
<section class="th th--b scene" id="top" data-hero="b" data-scene="team-hero" data-title={team.label} data-intro>
  <div class="tl__field" aria-hidden="true">
    {rows.map((row, i) => (
      <div class="tl__row" style={`--r:${i}`} data-dir={i % 2 ? 'ltr' : 'rtl'}>
        {[0, 1].map(() => (
          <span class="tl__track">
            {row.map((t) => (<><span class="tl__t">{t}</span><i class="tl__sep"></i></>))}
          </span>
        ))}
      </div>
    ))}
  </div>
  <i class="tl__line" aria-hidden="true"></i>
  <i class="tl__core" data-anchor aria-hidden="true"></i>
  <HeroCopy count center lang={lang} />
</section>
<div class="link link--hero" aria-hidden="true"><i></i></div>
