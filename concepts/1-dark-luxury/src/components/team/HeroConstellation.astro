---
/** Opening A · the constellation: twenty-plus points on three orbits, every ray leading to the name. */
import Mark from '../Mark.astro';
import HeroCopy from './HeroCopy.astro';
import { team } from '../../../../shared/content.ts';

const { hero } = team;

// More than twenty lawyers and counsel on three orbits, every ray leading to one centre.
// Deterministic jitter so the field looks hand-placed and never changes between builds.
const jit = (k: number) => {
  const x = Math.sin(k * 12.9898 + 78.233) * 43758.5453;
  return x - Math.floor(x) - 0.5;
};
const orbits = [
  { r: 124, n: 6, off: 18, size: 9 },
  { r: 198, n: 8, off: 4, size: 8 },
  { r: 270, n: 10, off: 11, size: 7 },
].map((o, oi) => ({
  ...o,
  nodes: Array.from({ length: o.n }, (_, i) => {
    const k = oi * 31 + i;
    const a = ((o.off + (i * 360) / o.n + jit(k) * 16) * Math.PI) / 180;
    const r = o.r + jit(k + 7) * 22;
    return { x: +(Math.cos(a) * r).toFixed(1), y: +(Math.sin(a) * r).toFixed(1) };
  }),
}));
---
<!-- ============ 1 · OPENING — many points, one light ============ -->
<section class="th th--a scene" id="top" data-hero="a" data-scene="team-hero" data-title={team.label} data-intro>
  <div class="th__vis" aria-hidden="true">
    <svg class="constel" viewBox="-300 -300 600 600">
      <defs>
        <linearGradient id="cnGold" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#fbe7b4" />
          <stop offset="0.6" stop-color="#c9a25a" />
          <stop offset="1" stop-color="#ad832d" />
        </linearGradient>
        <radialGradient id="cnHalo">
          <stop offset="0" stop-color="#e2be76" stop-opacity="0.32" />
          <stop offset="0.55" stop-color="#e2be76" stop-opacity="0.06" />
          <stop offset="1" stop-color="#e2be76" stop-opacity="0" />
        </radialGradient>
      </defs>
      <circle class="cn__halo" r="300" fill="url(#cnHalo)" />
      {orbits.map((o, oi) => (
        <g class="cn__orbit" data-orbit={oi}>
          <circle class="cn__ring" r={o.r} />
          {o.nodes.map((p, i) => (
            <g class="cn__node" style={`--k:${oi * 10 + i}`}>
              <line class="cn__ray" x1={p.x} y1={p.y} x2="0" y2="0" pathLength="1" />
              <rect class="cn__pt" x={-o.size / 2} y={-o.size / 2} width={o.size} height={o.size} transform={`translate(${p.x} ${p.y}) rotate(45)`} fill="url(#cnGold)" />
            </g>
          ))}
        </g>
      ))}
    </svg>
    <div class="th__core" data-anchor>
      <Mark uid="tc" variant="mark" glow />
    </div>
    <p class="th__count">
      <bdi dir="ltr" class="th__num">+<span class="odo odo--md" data-odo={hero.count.value}>{hero.count.value}</span></bdi>
      <span class="th__unit">{hero.count.unit}</span>
    </p>
  </div>

  <HeroCopy />
</section>
<div class="link link--hero" aria-hidden="true"><i></i></div>
