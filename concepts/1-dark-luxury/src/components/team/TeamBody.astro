---
/** Page 3 after its opening: the leadership arches and the legal groups with their scope dropdowns. */
import { ar } from '../../lib/format';
import { team } from '../../../../shared/content.ts';

const { leadership, groups } = team;

// «عنوان: تفاصيل» → the title in gold, the details after it.
const scopeParts = (s: string) => {
  const i = s.indexOf(':');
  return i > 0 ? { k: s.slice(0, i), v: s.slice(i + 1).trim() } : { k: '', v: s };
};
---
<!-- ============ 2 · LEADERSHIP — three lit arches ============ -->
<section class="ldr scene" id="leadership" data-scene="leadership" data-title={leadership.title}>
  <div class="ldr__head">
    <p class="eyebrow" data-reveal="rule"><i class="rh"></i><span>{leadership.label}</span></p>
    <h2 class="t-h1" data-split>{leadership.title}</h2>
  </div>
  <ol class="ldr__list">
    {leadership.members.map((m, i) => (
      <li class:list={['ldr__item', { 'is-featured': m.featured }]} style={`--i:${i}`}>
        <figure class="arch" data-anchor={m.featured ? '' : undefined}>
          <svg class="arch__frame" viewBox="0 0 100 130" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0.6 130 V50 A49.4 49.4 0 0 1 99.4 50 V130" pathLength="1" />
          </svg>
          <div class="arch__win">
            <i class="arch__halo" aria-hidden="true"></i>
            <i class="arch__rays" aria-hidden="true"></i>
            <img
              class="arch__img"
              src={`/team/${m.photo}.webp`}
              srcset={`/team/${m.photo}-360.webp 360w, /team/${m.photo}.webp 560w`}
              sizes="(max-width: 860px) 78vw, 27vw"
              width="560"
              height="700"
              alt={m.name}
              loading="lazy"
              decoding="async"
            />
            <i class="arch__sheen" aria-hidden="true"></i>
          </div>
        </figure>
        <div class="ldr__text">
          <p class="ldr__label">{m.label}</p>
          <h3 class="ldr__name">{m.name}</h3>
          <p class="ldr__role">{m.role}</p>
          <p class="ldr__creds">{m.creds}</p>
          <i class="ldr__rule" aria-hidden="true"></i>
          <p class="ldr__bio">{m.bio}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
<div class="link" aria-hidden="true"><i></i></div>

<!-- ============ 3 · GROUPS — each specialism, its own team ============ -->
<section class="grp scene" id="groups" data-scene="groups" data-title={groups.label}>
  <div class="grp__head">
    <p class="eyebrow" data-reveal="rule"><i class="rh"></i><span>{groups.label}</span></p>
    <h2 class="t-h1" data-split>{groups.title}</h2>
    <p class="grp__body" data-reveal="wipe">{groups.body}</p>
    <p class="grp__hint" data-reveal="wipe">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11.5V5.8a1.6 1.6 0 0 1 3.2 0V11m0-1.4a1.6 1.6 0 0 1 3.2 0V11m0-.6a1.6 1.6 0 0 1 3.2 0v4.4c0 3.6-2.4 6.2-6 6.2-2.5 0-4-1.1-5.3-3l-2.4-3.6a1.5 1.5 0 0 1 2.3-1.9L9 14" /></svg>
      <span>{groups.hint}</span>
    </p>
  </div>
  <ol class="grp__list">
    {groups.items.map((g, i) => (
      <li class="gc" style={`--i:${i}`} data-group>
        <button class="gc__trigger" type="button" aria-expanded="false" aria-controls={`scope-${i + 1}`}>
          <span class="gc__medal" data-hover>
            <svg class="gc__orbit" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="48.5" pathLength="100" /></svg>
            <span class="gc__disc">
              {g.photo
                ? <img src={`/team/${g.photo}.webp`} width="440" height="440" alt={g.leader} loading="lazy" decoding="async" />
                : <>
                    <img class="gc__logo gc__logo--night" src="/team/alfaisal-mark-dark.svg" width="120" height="120" alt={g.leader} loading="lazy" decoding="async" />
                    <img class="gc__logo gc__logo--day" src="/team/alfaisal-mark.svg" width="120" height="120" alt="" loading="lazy" decoding="async" />
                  </>}
            </span>
          </span>
          <span class="gc__idx naskh" aria-hidden="true">{ar(i + 1)}</span>
          <span class="gc__name" data-hover>{g.name}</span>
          <span class="gc__lead">
            <small>{g.leadTitle}</small>
            <span>{g.leader}</span>
          </span>
          <span class="gc__cue">
            <span>نطاق العمل</span>
            <svg viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5l5-5" /></svg>
          </span>
        </button>
        <div class="gc__drop" id={`scope-${i + 1}`} role="region" aria-label={`نطاق عمل ${g.name}`}>
          <i class="gc__thread" aria-hidden="true"></i>
          <div class="gc__panel">
            <p class="gc__k"><i class="rh rh--sm"></i><span>نطاق العمل</span></p>
            <ul class="gc__scope">
              {g.scope.map((s) => {
                const p = scopeParts(s);
                return (
                  <li>
                    <i class="gc__dot" aria-hidden="true"></i>
                    <span>{p.k && <b>{p.k}:</b>} {p.v}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>
<div class="link" aria-hidden="true"><i></i></div>
