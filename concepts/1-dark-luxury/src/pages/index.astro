---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import logoRaw from '../../../shared/logo/alfaisal-logo-on-dark.svg?raw';
import {
  site,
  contact,
  nav,
  hero,
  stats,
  story,
  expertise,
  method,
  values,
  closing,
  formatNumber,
} from '../../../shared/content.ts';

const wordmark = (logoRaw.match(/<g id="wordmark"[^>]*>([\s\S]*?)<\/g>/) || [])[1] || '';

// Arabic-Indic numerals in Naskh are used only as ornamental indexes.
const ar = (n: number) => String(n).padStart(2, '0').replace(/\d/g, (d) => '٠١٢٣٤٥٦٧٨٩'[+d]);
const maxLog = Math.log10(Math.max(...stats.items.map((i) => i.value)));
const measure = (v: number) => (Math.log10(v) / maxLog).toFixed(3);
const year = 2026;

// «ليست كل الملفات قضية»: the last word is struck through by a hand-drawn gold stroke.
const storyTitleWords = story.title.split(' ');
const storyTitleStruck = storyTitleWords.pop();
const storyTitleHead = storyTitleWords.join(' ');
const STRIKE_INK =
  'M101.05 13.70 L99.93 12.61 L98.71 12.07 L97.47 11.63 L96.21 11.24 L94.93 10.90 L93.65 10.59 L92.35 10.31 L91.04 10.06 L89.72 9.82 L88.39 9.61 L87.05 9.41 L85.71 9.23 L84.35 9.07 L82.99 8.92 L81.62 8.79 L80.25 8.67 L78.87 8.56 L77.48 8.46 L76.08 8.37 L74.68 8.30 L73.27 8.24 L71.86 8.18 L70.44 8.14 L69.02 8.10 L67.59 8.07 L66.15 8.05 L64.71 8.04 L63.27 8.03 L61.82 8.03 L60.36 8.04 L58.91 8.05 L57.44 8.07 L55.97 8.09 L54.50 8.12 L53.02 8.15 L51.54 8.19 L50.06 8.23 L48.57 8.27 L47.08 8.31 L45.58 8.35 L44.08 8.40 L42.57 8.45 L41.06 8.50 L39.55 8.55 L38.03 8.60 L36.51 8.65 L34.99 8.70 L33.46 8.75 L31.93 8.80 L30.40 8.85 L28.86 8.90 L27.32 8.95 L25.77 8.99 L24.22 9.04 L22.67 9.08 L21.11 9.12 L19.56 9.17 L17.99 9.22 L16.42 9.27 L14.85 9.33 L13.28 9.42 L11.69 9.57 L10.09 9.81 L8.51 9.68 L6.94 9.54 L5.36 9.39 L3.78 9.23 L2.20 9.07 L0.62 8.89 L-0.96 8.70 L-1.04 9.30 L0.55 9.49 L2.14 9.66 L3.72 9.83 L5.30 9.99 L6.88 10.14 L8.46 10.28 L10.04 10.41 L11.59 10.90 L13.14 11.28 L14.70 11.58 L16.27 11.85 L17.83 12.09 L19.39 12.30 L20.95 12.51 L22.51 12.70 L24.06 12.88 L25.62 13.04 L27.17 13.20 L28.72 13.35 L30.26 13.49 L31.81 13.62 L33.34 13.75 L34.88 13.87 L36.41 13.98 L37.94 14.09 L39.47 14.18 L40.99 14.28 L42.50 14.37 L44.01 14.45 L45.52 14.53 L47.02 14.60 L48.52 14.67 L50.01 14.73 L51.49 14.79 L52.98 14.85 L54.45 14.90 L55.92 14.95 L57.38 15.00 L58.84 15.04 L60.29 15.08 L61.74 15.12 L63.18 15.15 L64.61 15.18 L66.04 15.21 L67.46 15.24 L68.87 15.27 L70.28 15.29 L71.68 15.31 L73.07 15.34 L74.46 15.36 L75.84 15.37 L77.21 15.39 L78.57 15.41 L79.93 15.42 L81.28 15.44 L82.62 15.45 L83.96 15.46 L85.29 15.47 L86.61 15.47 L87.93 15.48 L89.24 15.48 L90.55 15.47 L91.84 15.46 L93.14 15.44 L94.43 15.42 L95.71 15.37 L97.00 15.31 L98.28 15.20 L99.58 15.01 L100.95 14.30 Z';
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{site.name}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#070b14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/almarai-arabic-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/almarai-arabic-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/almarai-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/almarai-latin-800.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var mm = window.matchMedia;
        var rm = mm && mm('(prefers-reduced-motion: reduce)').matches;
        // landscape phones are too short for pinned scenes: they get the complete static page
        var shortQ = '(max-height: 560px) and (orientation: landscape)';
        var short = mm && mm(shortQ).matches;
        if (short) d.classList.add('short');
        if (!rm && !short) d.classList.add('fx', 'is-intro');
        if (mm) {
          var q = mm(shortQ);
          var onq = function () { if (q.matches !== short) location.reload(); };
          q.addEventListener ? q.addEventListener('change', onq) : q.addListener(onq);
        }
        // Safety net: if the main script never boots, fall back to the static, complete page.
        setTimeout(function () {
          if (!window.__alfReady) d.classList.remove('fx', 'is-intro');
        }, 6000);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">تخطَّ إلى المحتوى</a>

    <canvas id="gl" aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>

    <!-- Transition veil: one gesture for every jump (a gold edge of light sweeping right → left). -->
    <div class="veil" aria-hidden="true">
      <div class="veil__glass"></div>
      <div class="veil__edge"></div>
      <div class="veil__card">
        <i class="rh"></i>
        <span class="veil__title"></span>
      </div>
    </div>

    <!-- ============ HEADER ============ -->
    <header class="hdr">
      <a class="hdr__logo" href="#top" data-nav aria-label={site.name}>
        <Mark uid="hm" variant="header" />
        <svg class="hdr__wordmark" viewBox="0 870 1031 205" aria-hidden="true"><g fill="#f1eadf" set:html={wordmark} /></svg>
      </a>
      <nav class="hdr__nav" aria-label="القائمة الرئيسية">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} data-nav data-soon={item.soon ? '' : undefined}>
                {item.label}
                {item.soon && <small class="soon-tag">قريبًا</small>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="hdr__actions">
        <button class="hdr__menu" type="button" aria-expanded="false" aria-controls="mnav">
          <span class="sr">القائمة</span>
          <i></i><i></i>
        </button>
        <a class="consult" href={site.consultUrl} target="_blank" rel="noopener">
          <span class="consult__mic" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M6 11a6 6 0 0 0 12 0M12 17v4M9 21h6" /></svg>
          </span>
          <span class="consult__label">احجز استشارة</span>
          <span class="consult__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        </a>
      </div>
    </header>

    <div class="mnav" id="mnav" hidden>
      <ul>
        {nav.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} data-nav>
              <span class="mnav__n">{ar(i + 1)}</span>
              <span class="mnav__t">{item.label}</span>
              {item.soon && <small class="soon-tag">قريبًا</small>}
            </a>
          </li>
        ))}
      </ul>
      <div class="mnav__foot">
        <a href={`tel:${contact.phones[0].tel}`} dir="ltr">{contact.phones[0].display}</a>
        <a href={`mailto:${contact.email}`} dir="ltr">{contact.email}</a>
      </div>
    </div>

    <main id="main">
      <!-- ============ 1 · HERO — the logo is the lamp ============ -->
      <section class="hero scene" id="top" data-scene="hero" data-title="الرئيسية">
        <div class="hero__mark" data-anchor>
          <Mark uid="hx" variant="mark" write glow label={site.name} />
        </div>
        <div class="hero__copy">
          <p class="eyebrow hero__eyebrow" data-reveal="rule"><i class="rh"></i><span>{hero.eyebrow}</span></p>
          <h1 class="hero__title">
            <span class="hero__l1" data-split>{hero.title[0]}</span>
            <span class="hero__l2 gold-text" data-split>{hero.title[1]}</span>
          </h1>
          <div class="hero__body">
            {hero.body.map((p) => <p data-reveal="wipe">{p}</p>)}
          </div>
          <div class="hero__cta" data-reveal="wipe">
            <a class="btn btn--glass" href="#contact" data-nav>
              <span>{hero.cta}</span>
              <svg class="btn__arrow" viewBox="0 0 24 12" aria-hidden="true"><path d="M23 6H2M7 1 2 6l5 5" /></svg>
            </a>
            <p class="hero__tag" aria-label={site.tagline.join('، ')}>
              {site.tagline.map((t, i) => (
                <>
                  {i > 0 && <i class="rh rh--sm"></i>}
                  <span>{t}</span>
                </>
              ))}
            </p>
          </div>
        </div>
      </section>
      <div class="link link--hero" aria-hidden="true"><i></i></div>

      <!-- ============ 2 · STORY — «الملف يُفتح»: a file opens and becomes a system ============ -->
      <section class="story scene" id="about" data-scene="story" data-title={story.label}>
        <div class="story__stage">
          <div class="story__text">
            <p class="eyebrow" data-reveal="rule"><i class="rh"></i><span>{story.label}</span></p>
            <h2 class="story__title" data-split>
              {storyTitleHead}{' '}<span class="qadiya">{storyTitleStruck}<svg class="strike" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="strikeGold" x1="1" y1="0" x2="0" y2="0">
                    <stop offset="0" stop-color="#f8e4b0" />
                    <stop offset="0.5" stop-color="#e2be76" />
                    <stop offset="1" stop-color="#b8893a" />
                  </linearGradient>
                  <mask id="strikeMask" maskUnits="userSpaceOnUse" x="-4" y="-4" width="108" height="32">
                    <path class="strike__m" d="M101 14.0 C72 9.5 36 13.5 -1 9.0" fill="none" stroke="#fff" stroke-width="16" stroke-linecap="butt" pathLength="1" />
                  </mask>
                </defs>
                <path class="strike__ink" d={STRIKE_INK} fill="url(#strikeGold)" mask="url(#strikeMask)" />
              </svg></span>
            </h2>
            <div class="story__body">
              <p class="story__l story__l1">{story.body[0]}</p>
              <p class="story__l story__l2">{story.body[1]}</p>
              <div class="story__l story__l3">
                <p class="story__value">{story.body[2]}</p>
                <p class="story__closing naskh"><span>{story.closing[0]}</span> <span>{story.closing[1]}</span></p>
              </div>
            </div>
          </div>
          <div class="story__vis">
            <svg class="story__wires" aria-hidden="true"></svg>
            <div class="dossier" aria-hidden="true">
              <i class="dossier__back"></i><i class="dossier__front"><i class="dossier__label"></i></i>
            </div>
            <ul class="story__sheets" aria-label="تفاصيل الملف">
              {story.words.map((w, i) => (
                <li class="sheet" style={`--i:${i}`}>
                  <span class="sheet__w">{w}</span><i class="sheet__rule" aria-hidden="true"></i><i class="sheet__lines" aria-hidden="true"></i>
                </li>
              ))}
            </ul>
            <i class="story__seal" data-anchor aria-hidden="true"></i>
          </div>
        </div>
      </section>
      <div class="link link--story" aria-hidden="true"><i></i></div>

      <!-- ============ 3 · NUMBERS — the record settles like a mechanism ============ -->
      <section class="nums scene" id="numbers" data-scene="numbers" data-title={stats.label}>
        <div class="nums__top">
          <p class="eyebrow" data-reveal="rule"><i class="rh"></i><span>{stats.label}</span></p>
          <div class="lead-num" data-anchor>
            <span class="lead-num__pre">{stats.lead.prefix}</span>
            <span class="odo odo--xl" data-odo={stats.lead.value} dir="ltr">{formatNumber(stats.lead.value)}</span>
            <span class="lead-num__unit">{stats.lead.unit}</span>
          </div>
          <p class="nums__sub t-h2">
            <span data-split>{stats.subtitle[0]}</span>
            <span class="gold-text" data-split>{stats.subtitle[1]}</span>
          </p>
        </div>
        <ol class="ledger glass">
          {stats.items.map((it, i) => (
            <li class="ledger__item" style={`--m:${measure(it.value)};--i:${i}`}>
              <span class="ledger__n">{ar(i + 1)}</span>
              <span class="odo odo--md" data-odo={it.value} dir="ltr">{formatNumber(it.value)}</span>
              <span class="ledger__label">{it.label}</span>
              <i class="ledger__measure" aria-hidden="true"></i>
            </li>
          ))}
        </ol>
      </section>
      <div class="link" aria-hidden="true"><i></i></div>

      <!-- ============ 4 · EXPERTISE — one instrument, six engravings ============ -->
      <section class="xp scene" id="expertise" data-scene="expertise" data-title={expertise.label}>
        <div class="xp__stage">
          <div class="xp__dial" aria-hidden="true">
            <svg class="xp__ticks" viewBox="-500 -500 1000 1000"></svg>
            <div class="xp__ring">
              {expertise.items.map((it, i) => (
                <span class="xp__lbl" style={`--i:${i}`}><span>{it.title}</span></span>
              ))}
            </div>
            <div class="xp__num">
              {expertise.items.map((_, i) => (
                <span class="xp__nm" style={`--i:${i}`}><span>{ar(i + 1)}</span></span>
              ))}
            </div>
            <i class="xp__beam"></i>
            <i class="xp__core" data-anchor></i>
          </div>
          <div class="xp__col">
          <div class="xp__head">
            <p class="eyebrow" data-reveal="rule"><i class="rh"></i><span>{expertise.label}</span></p>
            <h2 class="t-h1 xp__title" data-split>{expertise.title}</h2>
          </div>
          <ol class="xp__list">
            {expertise.items.map((it, i) => (
              <li class="xp__item" style={`--i:${i}`}>
                <h3 class="xp__h">
                  <button class="xp__row" type="button" data-i={i}>
                    <span class="xp__idx naskh">{ar(i + 1)}</span>
                    <span class="xp__t">{it.title}</span>
                  </button>
                </h3>
                <div class="xp__body"><p class="xp__p">{it.body}</p></div>
              </li>
            ))}
          </ol>
          </div>
        </div>
      </section>
      <div class="link" aria-hidden="true"><i></i></div>

      <!-- ============ 5 · METHOD — from noise to one line ============ -->
      <section class="mth scene" id="method" data-scene="method" data-title={method.label}>
        <div class="mth__stage">
          <div class="mth__head">
            <p class="eyebrow" data-reveal="rule"><i class="rh"></i><span>{method.label}</span></p>
            <h2 class="t-h1 mth__title">
              <span data-split>{method.title[0]}</span>
              <span class="gold-text" data-split>{method.title[1]}</span>
            </h2>
            <p class="mth__body" data-reveal="wipe">{method.body}</p>
          </div>
          <div class="mth__rail">
            <canvas class="mth__wave" aria-hidden="true"></canvas>
            <ol class="mth__steps">
              {method.steps.map((s, i) => (
                <li class="mth__step" style={`--i:${i}`}>
                  <span class="mth__n naskh">{ar(i + 1)}</span>
                  <i class="mth__node" aria-hidden="true"></i>
                  <span class="mth__w">{s}</span>
                </li>
              ))}
            </ol>
            <i class="mth__seal" data-anchor aria-hidden="true"></i>
          </div>
        </div>
      </section>
      <div class="link" aria-hidden="true"><i></i></div>

      <section class="stmt scene" data-scene="statement" data-title={method.label}>
        <i class="stmt__line" aria-hidden="true"></i>
        <p class="stmt__text">
          <span class="stmt__a" data-light>{method.statement[0]}</span>
          <span class="stmt__b gold-text" data-light data-anchor>{method.statement[1]}</span>
        </p>
        <a class="btn btn--glass stmt__cta" href="#about" data-nav>
          <span>{method.cta}</span>
          <svg class="btn__arrow" viewBox="0 0 24 12" aria-hidden="true"><path d="M23 6H2M7 1 2 6l5 5" /></svg>
        </a>
      </section>
      <div class="link" aria-hidden="true"><i></i></div>

      <!-- ============ 6 · VALUES — scroll fills each value with light ============ -->
      <section class="val scene" id="values" data-scene="values" data-title={values.label}>
        <div class="val__stage">
          <div class="val__head">
            <p class="eyebrow" data-reveal="rule"><i class="rh"></i><span>{values.label}</span></p>
            <h2 class="t-h1" data-split>{values.title}</h2>
          </div>
          <ul class="val__wall">
            {values.items.map((v, i) => (
              <li class="val__item" style={`--i:${i}`}>
                <span class="val__word"><i class="val__rh" aria-hidden="true"></i><span class="val__ink"><span class="val__base">{v.title}</span><span class="val__lit" aria-hidden="true">{v.title}</span></span></span><span class="val__body"><span class="val__bi">{v.body}</span></span>
              </li>
            ))}
          </ul>
        </div>
      </section>
      <div class="link" aria-hidden="true"><i></i></div>

      <!-- ============ 7 · TEAM — light under a closed door ============ -->
      <section class="team scene" id="team" data-scene="team" data-title="فريقنا">
        <div class="team__door" aria-hidden="true">
          <i class="team__leaf"></i>
          <i class="team__gap" data-anchor></i>
          <i class="team__spill"></i>
        </div>
        <div class="team__copy">
          <p class="eyebrow" data-reveal="rule"><i class="rh"></i><span>فريقنا</span></p>
          <h2 class="team__soon naskh gold-text">قريبًا</h2>
        </div>
        <p class="team__note" data-reveal="wipe">نعرّفكم بفريق الفيصل قريبًا.</p>
      </section>
      <div class="link" aria-hidden="true"><i></i></div>

      <!-- ============ 8 · CLOSING — the voice ============ -->
      <section class="cta scene" id="contact" data-scene="contact" data-title={closing.label}>
        <p class="cta__lead" data-reveal="wipe">
          <span>كل ملف يضيف إلى خبرتنا…</span>
          <span>وكل عميل يضيف إلى مسؤوليتنا.</span>
        </p>
        <h2 class="cta__title" data-split>{closing.title}</h2>
        <p class="cta__body" data-reveal="wipe">
          <span>{closing.body[0]}</span>
          <span>{closing.body[1]}</span>
        </p>

        <a class="voice" href={site.consultUrl} target="_blank" rel="noopener">
          <canvas class="voice__wave voice__wave--r" aria-hidden="true"></canvas>
          <span class="voice__ring" data-anchor>
            <i class="voice__pulse"></i><i class="voice__pulse"></i>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M6 11a6 6 0 0 0 12 0M12 17v4M9 21h6" /></svg>
          </span>
          <canvas class="voice__wave voice__wave--l" aria-hidden="true"></canvas>
          <span class="voice__label">احجز استشارة</span>
        </a>

        <div class="contact glass">
          <div class="contact__col">
            <p class="contact__k">الهاتف</p>
            <ul class="contact__v">
              {contact.phones.map((p) => (
                <li><a href={`tel:${p.tel}`}><bdi dir="ltr">{p.display}</bdi></a><small>{p.label}</small></li>
              ))}
            </ul>
          </div>
          <div class="contact__col">
            <p class="contact__k">واتساب</p>
            <p class="contact__v"><a href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener"><bdi dir="ltr">{contact.phones[0].display}</bdi></a></p>
            <p class="contact__k">البريد الإلكتروني</p>
            <p class="contact__v"><a href={`mailto:${contact.email}`}><bdi dir="ltr">{contact.email}</bdi></a></p>
          </div>
          <div class="contact__col">
            <p class="contact__k">العنوان</p>
            <address class="contact__v">
              {contact.address.line}<br />{contact.address.city}، {contact.address.country}
            </address>
            <a class="contact__map" href={contact.mapsUrl} target="_blank" rel="noopener">
              <span>افتح الخريطة</span>
              <svg class="btn__arrow" viewBox="0 0 24 12" aria-hidden="true"><path d="M23 6H2M7 1 2 6l5 5" /></svg>
            </a>
          </div>
        </div>
      </section>
      <div class="link" aria-hidden="true"><i></i></div>
    </main>

    <!-- ============ OUTRO — the lamp goes out last on the name ============ -->
    <footer class="outro scene" data-scene="outro" data-title="الفيصل">
      <div class="outro__logo" data-anchor>
        <Mark uid="ft" variant="lockup" write glow label={site.name} />
      </div>
      <div class="outro__bar">
        <p>© <bdi dir="ltr">{year}</bdi> {site.name}</p>
        <p>السجل التجاري <bdi dir="ltr" class="tnum">{site.commercialRegistry}</bdi></p>
        <a href="#top" data-nav class="outro__top">
          <span>العودة إلى البداية</span>
          <svg viewBox="0 0 12 24" aria-hidden="true"><path d="M6 23V2M1 7l5-5 5 5" /></svg>
        </a>
      </div>
    </footer>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
