---
/**
 * PAGE 3 · فريقنا / Our team — «خبرات متعددة… تحت قيادة واحدة»
 * The opening («سطور كثيرة… سطر واحد»), the leadership in lit arches, and the legal departments whose scope of work
 * rises over the card from the director's portrait or the department's name.
 */
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import HeroLines from '../components/team/HeroLines.astro';
import TeamBody from '../components/team/TeamBody.astro';
import { getContent, type Lang } from '../../../shared/i18n.ts';

interface Props { lang?: Lang }
const { lang = 'ar' } = Astro.props;
const { team } = getContent(lang);
---
<Base page="team" lang={lang} title={team.pageTitle} description={team.description}>
  <HeroLines lang={lang} />
  <TeamBody lang={lang} />
  <Contact lang={lang} />
</Base>