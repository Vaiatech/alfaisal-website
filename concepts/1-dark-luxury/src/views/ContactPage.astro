---
/**
 * PAGE · تواصل معنا — simple and direct: the invitation, four ways to reach the firm
 * (each card opens the call, the chat, the email or the map), and the consultation itself.
 * No form: every card leads straight to a real channel.
 */
import Base from '../layouts/Base.astro';
import { getContent, type Lang } from '../../../shared/i18n.ts';

interface Props { lang?: Lang }
const { lang = 'ar' } = Astro.props;
const { site, contact, contactPage, ui } = getContent(lang);
const p = contactPage;
const sep = lang === 'en' ? ', ' : '، ';
const wa = `https://wa.me/${contact.whatsapp}`;
---
<Base page="contact" lang={lang} title={p.pageTitle} description={p.description}>
  <!-- ============ 1 · THE INVITATION ============ -->
  <section class="cp scene" id="top" data-scene="contact-page" data-title={p.label} data-intro>
    <div class="cp__head">
      <p class="eyebrow cp__eyebrow"><i class="rh"></i><span>{p.label}</span></p>
      <h1 class="cp__title" data-split data-anchor>{p.title}</h1>
      <p class="cp__lead"><span>{p.lead[0]}</span> <span>{p.lead[1]}</span></p>
    </div>

    <!-- ============ 2 · FOUR WAYS IN ============ -->
    <h2 class="sr">{p.channelsLabel}</h2>
    <ul class="cp__cards">
      <li class="cc">
        <span class="cc__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M6.6 3.2 9 3a1.2 1.2 0 0 1 1.2.8l1 2.9a1.2 1.2 0 0 1-.3 1.3L9.5 9.4a11 11 0 0 0 5.1 5.1l1.4-1.4a1.2 1.2 0 0 1 1.3-.3l2.9 1a1.2 1.2 0 0 1 .8 1.2l-.2 2.4a1.8 1.8 0 0 1-1.9 1.6A16.5 16.5 0 0 1 3.2 5.1a1.8 1.8 0 0 1 1.6-1.9Z" /></svg>
        </span>
        <p class="cc__k">{ui.phone}</p>
        <ul class="cc__phones">
          {contact.phones.map((ph) => (
            <li><a href={`tel:${ph.tel}`}><bdi dir="ltr">{ph.display}</bdi></a><small>{ph.label}</small></li>
          ))}
        </ul>
      </li>
      <li class="cc">
        <a class="cc__link" href={wa} target="_blank" rel="noopener" aria-label={`${ui.whatsapp} ${contact.phones[0].display}`}></a>
        <span class="cc__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4.2 20 5.3 16a8.3 8.3 0 1 1 3 2.9L4.2 20Z" /><path d="M9.2 8.4c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c.6 1.1 1.5 2 2.6 2.6l.6-.5c.2-.2.4-.2.6-.1l1.6.7c.4.1.4.3.4.5v.5c0 .3 0 .5-.4.7-.5.3-1.1.4-1.7.3-2.6-.6-4.7-2.7-5.3-5.3-.1-.6 0-1.2.3-1.7Z" /></svg>
        </span>
        <p class="cc__k">{ui.whatsapp}</p>
        <p class="cc__v"><bdi dir="ltr">{contact.phones[0].display}</bdi></p>
        <span class="cc__go">{ui.startChat} <svg class="btn__arrow" viewBox="0 0 24 12" aria-hidden="true"><path d="M23 6H2M7 1 2 6l5 5" /></svg></span>
      </li>
      <li class="cc">
        <a class="cc__link" href={`mailto:${contact.email}`} aria-label={`${ui.email} ${contact.email}`}></a>
        <span class="cc__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="3" y="5.5" width="18" height="13" rx="2" /><path d="m3.6 6.6 8.4 6.2 8.4-6.2" /></svg>
        </span>
        <p class="cc__k">{ui.email}</p>
        <p class="cc__v cc__v--mail"><bdi dir="ltr">{contact.email}</bdi></p>
        <span class="cc__go">{ui.writeUs} <svg class="btn__arrow" viewBox="0 0 24 12" aria-hidden="true"><path d="M23 6H2M7 1 2 6l5 5" /></svg></span>
      </li>
      <li class="cc">
        <a class="cc__link" href={contact.mapsUrl} target="_blank" rel="noopener" aria-label={`${ui.address}: ${contact.address.line}${sep}${contact.address.city} — ${ui.openMap}`}></a>
        <span class="cc__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></svg>
        </span>
        <p class="cc__k">{ui.address}</p>
        <address class="cc__v">{contact.address.line}<br />{contact.address.city}{sep}{contact.address.country}</address>
        <span class="cc__go">{ui.openMap} <svg class="btn__arrow" viewBox="0 0 24 12" aria-hidden="true"><path d="M23 6H2M7 1 2 6l5 5" /></svg></span>
      </li>
    </ul>
  </section>
  <div class="link" aria-hidden="true"><i></i></div>

  <!-- ============ 3 · WRITE TO US · AND WHERE WE ARE ============ -->
  <section class="cf scene" id="write" data-scene="contact-form" data-title={p.form.label}>
    <div class="cf__grid">
      <form class="cf__form glass" id="cform" data-i18n={JSON.stringify(ui.form)} action={`https://wa.me/${contact.whatsapp}`} method="get" novalidate>
        <p class="eyebrow" data-reveal="rule"><i class="rh"></i><span>{p.form.label}</span></p>
        <h2 class="cf__title" data-split>{p.form.title}</h2>
        <p class="cf__body">{p.form.body}</p>

        <div class="cf__row">
          <div class="fld">
            <label class="fld__l" for="f-name">{ui.form.name}</label>
            <input class="fld__i" id="f-name" name="name" type="text" autocomplete="name" required minlength="2" aria-describedby="f-name-e" />
            <p class="fld__e" id="f-name-e" aria-live="polite"></p>
          </div>
          <div class="fld">
            <label class="fld__l" for="f-phone">{ui.form.phone}</label>
            <input class="fld__i" id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" dir="ltr" placeholder="05x xxx xxxx" required aria-describedby="f-phone-e" />
            <p class="fld__e" id="f-phone-e" aria-live="polite"></p>
          </div>
        </div>

        <fieldset class="fld fld--topics">
          <legend class="fld__l">{ui.form.topic}</legend>
          <div class="chips">
            {p.form.topics.map((t, i) => (
              <label class="chip-r">
                <input type="radio" name="topic" value={t} checked={i === p.form.topics.length - 1} />
                <span>{t}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="fld">
          <label class="fld__l" for="f-msg">{ui.form.message}</label>
          <textarea class="fld__i fld__i--area" id="f-msg" name="text" rows="5" required minlength="10" aria-describedby="f-msg-e"></textarea>
          <p class="fld__e" id="f-msg-e" aria-live="polite"></p>
        </div>

        <div class="cf__actions">
          <button class="cf__send" type="submit">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.2 20 5.3 16a8.3 8.3 0 1 1 3 2.9L4.2 20Z" /><path d="M9.2 8.4c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c.6 1.1 1.5 2 2.6 2.6l.6-.5c.2-.2.4-.2.6-.1l1.6.7c.4.1.4.3.4.5v.5c0 .3 0 .5-.4.7-.5.3-1.1.4-1.7.3-2.6-.6-4.7-2.7-5.3-5.3-.1-.6 0-1.2.3-1.7Z" /></svg>
            <span>{p.form.send}</span>
          </button>
          <button class="cf__mail" type="button" data-mail>{p.form.mail}</button>
        </div>
        <p class="cf__privacy"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2" /><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" /></svg>{p.form.privacy}</p>
      </form>

      <div class="cf__map glass">
        <div class="cf__map-head">
          <p class="eyebrow" data-reveal="rule"><i class="rh"></i><span>{p.visit.label}</span></p>
          <h2 class="cf__title cf__title--sm" data-split>{p.visit.title}</h2>
          <address class="cf__addr">{contact.address.line}{sep}{contact.address.city}{sep}{contact.address.country}</address>
        </div>
        <div class="map">
          <iframe
            class="map__frame"
            src={contact.mapsEmbed}
            title={`${ui.map}: ${contact.address.line}${sep}${contact.address.city}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <i class="map__frame-edge" aria-hidden="true"></i>
        </div>
        <div class="cf__map-actions">
          <a class="btn btn--glass btn--sm" href={contact.directionsUrl} target="_blank" rel="noopener">
            <span>{p.visit.directions}</span>
            <svg class="btn__arrow" viewBox="0 0 24 12" aria-hidden="true"><path d="M23 6H2M7 1 2 6l5 5" /></svg>
          </a>
          <a class="cf__open" href={contact.mapsUrl} target="_blank" rel="noopener">{p.visit.open}</a>
        </div>
      </div>
    </div>
  </section>
  <div class="link" aria-hidden="true"><i></i></div>

  <!-- ============ 4 · THE CONSULTATION ============ -->
  <section class="cq scene" id="consult" data-scene="contact" data-title={p.consult.label}>
    <div class="cq__panel glass">
      <div class="cq__text">
        <p class="eyebrow" data-reveal="rule"><i class="rh"></i><span>{p.consult.label}</span></p>
        <h2 class="cq__title" data-split>{p.consult.title}</h2>
        <p class="cq__body" data-reveal="wipe">{p.consult.body}</p>
        <p class="cq__modes" data-reveal="wipe">
          {p.consult.modes.map((m, i) => (<>{i > 0 && <i class="cq__dot"></i>}<span>{m}</span></>))}
          <i class="cq__dot"></i><span class="cq__note">{p.consult.note}</span>
        </p>
      </div>
      <a class="voice cq__voice" href={site.consultUrl} target="_blank" rel="noopener">
        <canvas class="voice__wave voice__wave--r" aria-hidden="true"></canvas>
        <span class="voice__ring" data-anchor>
          <i class="voice__pulse"></i><i class="voice__pulse"></i>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M6 11a6 6 0 0 0 12 0M12 17v4M9 21h6" /></svg>
        </span>
        <canvas class="voice__wave voice__wave--l" aria-hidden="true"></canvas>
        <span class="voice__label"><span class="voice__line">{site.platform.line}</span><small class="voice__sub">{site.platform.sub}</small></span>
      </a>
    </div>
  </section>
  <div class="link" aria-hidden="true"><i></i></div>
</Base>
