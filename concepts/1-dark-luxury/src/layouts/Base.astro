---
/**
 * The shell every page shares: head, the light (WebGL), grain, the veil,
 * header + mobile menu, and the outro. Each page fills <main> and ends with <Contact />.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Outro from '../components/Outro.astro';
import { site, type Page } from '../../../shared/content.ts';

interface Props {
  page: Page;
  title?: string;
  description?: string;
}
const { page, title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
---
<!doctype html>
<html lang="ar" dir="rtl" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/almarai-arabic-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/almarai-arabic-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/almarai-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/almarai-latin-800.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var mm = window.matchMedia;
        var rm = mm && mm('(prefers-reduced-motion: reduce)').matches;
        // landscape phones are too short for pinned scenes: they get the complete static page
        var shortQ = '(max-height: 560px) and (orientation: landscape)';
        var short = mm && mm(shortQ).matches;
        if (short) d.classList.add('short');
        if (!rm && !short) {
          d.classList.add('fx');
          // arriving from another page: the veil is still closed; it opens once this page is ready
          var arriving = null;
          try { arriving = sessionStorage.getItem('alf-veil'); sessionStorage.removeItem('alf-veil'); } catch (e) {}
          if (arriving !== null) { d.classList.add('is-arriving'); window.__alfArriving = arriving; }
          else d.classList.add('is-intro');
        }
        if (mm) {
          var q = mm(shortQ);
          var onq = function () { if (q.matches !== short) location.reload(); };
          q.addEventListener ? q.addEventListener('change', onq) : q.addListener(onq);
        }
        // Safety net: if the main script never boots, fall back to the static, complete page.
        setTimeout(function () {
          if (!window.__alfReady) d.classList.remove('fx', 'is-intro', 'is-arriving');
        }, 6000);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">تخطَّ إلى المحتوى</a>

    <canvas id="gl" aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>

    <!-- Transition veil: one gesture for every jump (a gold edge of light sweeping right → left). -->
    <div class="veil" aria-hidden="true">
      <div class="veil__glass"></div>
      <div class="veil__edge"></div>
      <div class="veil__card">
        <i class="rh"></i>
        <span class="veil__title"></span>
      </div>
    </div>
    <script is:inline>
      // name the destination on the closed veil before the first paint
      if (window.__alfArriving) document.querySelector('.veil__title').textContent = window.__alfArriving;
    </script>

    <Header page={page} />

    <main id="main">
      <slot />
    </main>

    <Outro />

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
