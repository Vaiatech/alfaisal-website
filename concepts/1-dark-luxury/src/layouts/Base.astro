---
/**
 * The shell every page shares: head, the light (WebGL), grain, the veil,
 * header + mobile menu, and the outro. Each page fills <main> and ends with <Contact />.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Mark from '../components/Mark.astro';
import Outro from '../components/Outro.astro';
import type { Page } from '../../../shared/content.ts';
import { getContent, type Lang } from '../../../shared/i18n.ts';

interface Props {
  page: Page;
  title?: string;
  description?: string;
  /** previews and drafts stay out of search results */
  noindex?: boolean;
  lang?: Lang;
}
const { page, title, noindex = false, lang = 'ar' } = Astro.props;
const { site, ui, base, pagePath } = getContent(lang);
const description = Astro.props.description ?? site.description;
const arPath = pagePath(page, '');
const enPath = pagePath(page, '/en');
const fullTitle = title ? `${title} | ${site.name}` : site.name;
---
<!doctype html>
<html lang={lang} dir={lang === 'en' ? 'ltr' : 'rtl'} data-page={page} data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f6f1e8" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="ar" href={arPath} />
    <link rel="alternate" hreflang="en" href={enPath} />
    <link rel="preload" href="/fonts/almarai-arabic-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/almarai-arabic-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/almarai-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/almarai-latin-800.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        // day or night: the visitor's own choice, remembered; day otherwise (client notes: light is the default)
        var theme = null;
        try { theme = localStorage.getItem('alf-theme'); } catch (e) {}
        d.dataset.theme = theme === 'dark' ? 'dark' : 'light';
        if (theme === 'dark') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#070b14');
        var mm = window.matchMedia;
        var rm = mm && mm('(prefers-reduced-motion: reduce)').matches;
        // landscape phones are too short for pinned scenes: they get the complete static page
        var shortQ = '(max-height: 560px) and (orientation: landscape)';
        var short = mm && mm(shortQ).matches;
        if (short) d.classList.add('short');
        if (!rm && !short) {
          d.classList.add('fx');
          // arriving from another page: the veil is still closed; it opens once this page is ready
          var arriving = null;
          try { arriving = sessionStorage.getItem('alf-veil'); sessionStorage.removeItem('alf-veil'); } catch (e) {}
          if (arriving !== null) { d.classList.add('is-arriving'); window.__alfArriving = arriving; }
          else d.classList.add('is-intro');
        }
        if (mm) {
          var q = mm(shortQ);
          var onq = function () { if (q.matches !== short) location.reload(); };
          q.addEventListener ? q.addEventListener('change', onq) : q.addListener(onq);
        }
        // Safety net: if the main script never boots, fall back to the static, complete page.
        setTimeout(function () {
          if (!window.__alfReady) d.classList.remove('fx', 'is-intro', 'is-arriving');
        }, 6000);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip}</a>

    <canvas id="gl" aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>

    <!-- Transition veil: one gesture for every jump (a gold edge of light sweeping right → left). -->
    <div class="veil" aria-hidden="true">
      <div class="veil__glass"></div>
      <div class="veil__edge"></div>
      <div class="veil__card">
        <div class="veil__mark"><Mark uid="vm" variant="mark" glow /></div>
        <i class="veil__rule"><i class="rh rh--sm"></i></i>
        <span class="veil__title"></span>
      </div>
    </div>
    <script is:inline>
      // name the destination on the closed veil before the first paint
      if (window.__alfArriving) document.querySelector('.veil__title').textContent = window.__alfArriving;
    </script>

    <Header page={page} lang={lang} />

    <main id="main">
      <slot />
    </main>

    <Outro lang={lang} />

    <!-- The consultation platform, on every page: a gold ring with its microphone; its words show on arrival and on hover -->
    <a class="wa-fab" href={site.consultUrl} target="_blank" rel="noopener" aria-label={`${site.platform.line} — ${site.platform.sub}`}>
      <span class="wa-fab__label" aria-hidden="true">
        <span class="wa-fab__line">{site.platform.line}</span>
        <small class="wa-fab__sub">{site.platform.sub}</small>
      </span>
      <span class="wa-fab__ring">
        <i class="wa-fab__pulse"></i>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M6 11a6 6 0 0 0 12 0M12 17v4M9 21h6" /></svg>
      </span>
    </a>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
