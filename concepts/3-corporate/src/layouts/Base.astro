---
import '../styles/global.css';
import LogoDefs from '../components/LogoDefs.astro';
import { site } from '../data/content';

interface Props { title?: string }
const { title = `${site.name} | ${site.tagline.join(' · ')}` } = Astro.props;
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#F4F0E9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Only the faces the first screen uses are preloaded: Almarai Arabic 800 (headline), 700 (menu, labels), 400 (text). -->
    <link rel="preload" href="/fonts/almarai-arabic-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/almarai-arabic-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/almarai-arabic-400.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        d.classList.add('js');
        if (!rm) d.classList.add('motion');
        var seen = false;
        try { seen = !!sessionStorage.getItem('af3-intro'); } catch (e) {}
        if (/[?&]intro/.test(location.search)) seen = false;
        if (!rm && !seen) d.classList.add('play-intro');
        // Failsafe: if the scripts never start, show everything.
        setTimeout(function () { if (!d.classList.contains('ready')) d.classList.remove('motion', 'play-intro'); }, 5000);
      })();
    </script>
  </head>
  <body>
    <LogoDefs />
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
