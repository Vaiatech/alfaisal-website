---
// 06 · Idea: "The people behind the file". The ink statement field collapses into the pillar,
// which now carries «فريقنا — قريبًا». Beside it, the firm's three practice-group leaders in one
// frame system: the same tonal treatment, the same tight crop, the same keyline, rising in a stair.
import Guides from '../Guides.astro';
import Label from '../Label.astro';
import Mark from '../Mark.astro';

const people = [
  { src: '/img/portrait-sahl.jpg', i: '01' },
  { src: '/img/portrait-waleed.jpg', i: '02' },
  { src: '/img/portrait-ahmed.jpg', i: '03' },
];
---
<section class="sc team" id="team" data-tone="light" data-name="فريقنا" data-i="06">
  <Guides />
  <div class="grid team-grid">
    <div class="pillar team-pillar" data-tone="dark">
      <div class="relief" aria-hidden="true"><Mark class="relief-mark team-relief" calligraphyOnly /></div>
      <Label index="06" text="فريقنا" class="rv" />
      <p class="team-soon d2">
        <span class="ln"><span class="ln-i">قريبًا</span></span>
      </p>
      <p class="team-note rv">صفحة فريق الفيصل قيد الإعداد.</p>
      <span class="team-soon-bar" aria-hidden="true"></span>
    </div>

    <div class="team-head">
      <h2 class="team-title d2">
        <span class="ln"><span class="ln-i">الأشخاص</span></span>
        <span class="ln"><span class="ln-i">خلف الملف</span></span>
      </h2>
      <p class="team-cap rv">قادة مجموعات الممارسة</p>
    </div>

    <ul class="portraits">
      {people.map((p) => (
        <li class="pt">
          <figure>
            <div class="pt-frame">
              <img src={p.src} alt="أحد قادة مجموعات الممارسة في شركة الفيصل" width="720" height="900" loading="lazy" decoding="async" />
            </div>
            <figcaption><span dir="ltr" class="tnum">{p.i}</span><span class="rh" aria-hidden="true"></span><span>مجموعة ممارسة</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
