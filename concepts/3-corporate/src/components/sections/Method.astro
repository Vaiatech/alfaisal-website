---
// 05 · Idea: "From the first document to the last action". The expertise field folds back into the
// pillar, which runs the full height of the scene: title at the top, the current step as a giant reel
// numeral at the foot. Beside it, five verbs stand on one procedural rail that the scroll draws; each verb
// locks on as the rail reaches it. The pillar then grows into the ink field: «…بل بمنظومة.»
import Guides from '../Guides.astro';
import Label from '../Label.astro';
import Arrow from '../Arrow.astro';
import { method } from '../../data/content';
---
<section class="sc method" id="method" data-tone="light" data-name="منهجيتنا" data-i="05">
  <Guides />
  <div class="grid method-grid">
    <div class="pillar method-pillar" data-tone="maroon">
      <Label index="05" text={method.label} class="rv" />
      <h2 class="method-title">
        <span class="ln"><span class="ln-i">{method.title[0]}</span></span>
        <span class="ln"><span class="ln-i">{method.title[1]}</span></span>
      </h2>
      <span class="pillar-count" dir="ltr" aria-hidden="true">
        <span class="vbig"><span class="rl"><span class="rl-s"><i>0</i></span></span><span class="rl" data-mstep style="--d:5"><span class="rl-s"><i>0</i><i>1</i><i>2</i><i>3</i><i>4</i><i>5</i></span></span></span>
        <span class="vof">/ 05</span>
      </span>
    </div>

    <p class="method-body lead rv">{method.body}</p>

    <div class="rail" data-rail>
      <span class="rail-track" aria-hidden="true"><b></b></span>
      <ol class="rail-steps">
        {method.steps.map((s, i) => (
          <li class="st" data-st>
            <span class="st-node rh" aria-hidden="true"></span>
            <span class="st-i" dir="ltr">{String(i + 1).padStart(2, '0')}</span>
            <span class="st-t">{s}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="statement field-grow" data-tone="dark">
    <div class="field" aria-hidden="true"></div>
    <Guides />
    <div class="grid statement-grid">
      <p class="statement-1 d3">
        <span class="ln"><span class="ln-i">{method.statement[0]}</span></span>
      </p>
      <p class="statement-2">
        <span class="ln"><span class="ln-i">{method.statement[1]}</span></span>
      </p>
      <a class="btn btn-gold statement-cta" href="#about" data-go="about">
        <span class="btn-t">{method.cta}</span>
        <Arrow />
      </a>
    </div>
  </div>
</section>
